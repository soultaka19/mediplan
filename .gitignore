~$*.docx
~$*.xlsx
~$*.pptx

# Dossier personnel (brouillons, non versionné)
creation-diagramme-cas-d'utilisation/

# Companion visuel de brainstorming (local)
.superpowers/

# Captures d'audit à la racine (locales, non versionnées)
/*.png

# Fichiers de sauvegarde (jamais versionnés, où qu'ils soient), y compris les
