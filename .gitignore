# Dépendances
node_modules/
dist/
build/
coverage/

# Caches d'outils (monorepo)
.turbo/
.angular/
.pnpm-store/

# Environnement
.env
.env.local
*.local

# Secrets de déploiement (chaîne de connexion de la base infogérée, secret JWT
# de production…). Alimente les scripts de /scripts, n'est JAMAIS versionné.
.env.azure
.env.azure.*
# Secrets de deploiement sur le VPS : le depot y est clone JUSTE A COTE du
# fichier, un `git add -A` distrait suffirait a le publier.
deploy/*.env

# Logs
*.log
npm-debug.log*

# Éditeurs / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Outils locaux (agents / navigateur de test)
.claude/
.playwright/
.playwright-cli/

# Fichiers temporaires Office
~$*.docx
~$*.xlsx
~$*.pptx

# Companion visuel de brainstorming (local)
.superpowers/

# MediPlan-Demo.mp4 à la racine EST versionné : la consigne de remise exige que
# la vidéo démonstrative soit dans le dépôt. C'est un ré-encodage à 9,8 Mo
# (CRF 23), visuellement identique — le master de 58 Mo reste local, dans
# docs/presentation/video/out/, et se régénère depuis les sources.

# Captures de travail de l'application : 7 Mo qu'aucun document ne référence.
# Les captures qui SERVENT un livrable sont versionnées là où il les utilise
# (docs/guide-utilisation/captures/, docs/conception/images/,
# docs/reflexion-ux-ui/audit-after/). D'où la barre oblique initiale : elle
# limite la règle au dossier racine, sinon elle attrape aussi ceux-là.
/*.png
/captures/

# Fichiers de sauvegarde (jamais versionnés, où qu'ils soient), y compris les
# sauvegardes de .env (secrets) telles que .env.backup-avant-seed
*.backup
.env.backup*
