# Dépendances
node_modules/
dist/
build/
coverage/

# Caches d'outils (monorepo)
.turbo/
.angular/
.pnpm-store/

# Environnement
.env
.env.local
*.local

# Secrets de déploiement (chaîne de connexion de la base infogérée, secret JWT
# de production…). Alimente les scripts de /scripts, n'est JAMAIS versionné.
.env.azure
.env.azure.*

# Logs
*.log
npm-debug.log*

# Éditeurs / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Outils locaux (agents / navigateur de test)
.claude/
.playwright/
.playwright-cli/

# Fichiers temporaires Office
~$*.docx
~$*.xlsx
~$*.pptx

# Companion visuel de brainstorming (local)
.superpowers/

# Vidéo de démonstration, à la racine pour être trouvée tout de suite le jour de
# la présentation. Non versionnée : 58 Mo entreraient définitivement dans
# l'historique du dépôt, et GitHub avertit au-delà de 50 Mo. Pour la publier
# malgré tout, retirer cette ligne — ou verser une copie allégée :
#   ffmpeg -i MediPlan-Demo.mp4 -c:v libx264 -crf 26 -preset slow \
#          -c:a aac -b:a 128k MediPlan-Demo-leger.mp4
/MediPlan-Demo.mp4

# Captures de travail de l'application : 7 Mo qu'aucun document ne référence.
# Les captures qui SERVENT un livrable sont versionnées là où il les utilise
# (docs/conception/images/, docs/reflexion-ux-ui/audit-after/).
/*.png
captures/

# Fichiers de sauvegarde (jamais versionnés, où qu'ils soient), y compris les
# sauvegardes de .env (secrets) telles que .env.backup-avant-seed
*.backup
.env.backup*
