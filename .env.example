# MediPlan — variables d'environnement (exemple)
# Copier ce fichier en .env (gitignoré) et renseigner des valeurs réelles.
# Aucun secret réel ne doit être commité (décision sécurité Phase 2 — MEDIPLAN-39).

# --- Base de données PostgreSQL ---
# Utiliser 127.0.0.1 plutôt que « localhost » : sous Windows, localhost résout
# d'abord en IPv6 (::1), où wslrelay.exe peut intercepter le port publié par
# Docker et couper la connexion (ECONNRESET au démarrage / aux migrations).
DB_HOST=127.0.0.1
# Port publié sur la machine hôte. En cas de PostgreSQL déjà installé localement,
# changer cette valeur (ex. 5434) avant le premier `docker compose up`.
DB_PORT=5432
DB_NAME=mediplan
# Utilisateur applicatif non-superuser (moindre privilège)
DB_USER=mediplan_app
DB_PASSWORD=change_me

# Chiffrement TLS de la connexion à la base.
# false en local : la base est sur le réseau interne de Docker Compose.
# true OBLIGATOIREMENT face à une base infogérée (Neon, Azure Database for
# PostgreSQL), qui refuse toute connexion en clair.
DB_SSL=false
# Vérification de la chaîne de certification (défaut true, à garder).
# Passer à false uniquement face à un certificat auto-signé : la connexion reste
# chiffrée mais l'identité du serveur n'est plus vérifiée.
# DB_SSL_REJECT_UNAUTHORIZED=true

# --- Authentification / JWT (décisions sécurité Phase 2) ---
# Secret >= 32 octets aléatoires, différent par environnement
JWT_SECRET=change_me_with_a_long_random_secret
JWT_EXPIRES_IN=60m

# --- Hachage des mots de passe ---
BCRYPT_ROUNDS=12

# --- Verrouillage de compte (MEDIPLAN-16) ---
# Nombre de tentatives échouées avant verrouillage (défaut 5)
LOGIN_MAX_ATTEMPTS=5
# Durée du verrouillage en minutes (défaut 15)
LOGIN_LOCK_DURATION_MINUTES=15

# --- Réinitialisation de mot de passe (MEDIPLAN-16) ---
# Durée de validité du jeton de réinitialisation en minutes (défaut 30)
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# --- Ports applicatifs ---
BACKEND_PORT=3000
FRONTEND_PORT=4200

# =====================================================================
# Variables propres au DÉPLOIEMENT CLOUD (inutiles en développement local)
# =====================================================================
# Elles ne sont pas posées dans le .env local : elles sont injectées comme
# secrets/variables du service déployé (voir /infra et docs/deployment/azure.md).
#
# Joue les migrations TypeORM au démarrage du conteneur backend. En cloud il
# n'existe pas de console pour les lancer avant le boot, et les répliques
# naissent au gré du scale-to-zero. Idempotent (table `migrations`).
# RUN_MIGRATIONS_ON_BOOT=true
#
# Autorise le seed de démonstration malgré NODE_ENV=production. À ne poser QUE
# sur l'environnement vitrine, jamais sur des données réelles : le seed purge
# la clinique de démonstration et insère des comptes à mots de passe publics.
# ALLOW_DEMO_SEED=true
#
# Cible du proxy /api/ de nginx côté frontend (conteneur frontend uniquement).
# En local, la valeur par défaut de l'image (http://backend:3000) suffit.
# BACKEND_ORIGIN=https://<nom-du-backend>.internal.<domaine-environnement>
